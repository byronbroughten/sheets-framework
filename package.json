{
  "name": "@byronbroughten/sheets-framework",
  "version": "0.1.0",
  "description": "A TypeScript framework for typed apps on Google Sheets + Apps Script.",
  "type": "module",
  "license": "ISC",
  "exports": {
    ".": "./src/framework.ts",
    "./testing": "./src/frameworkTesting.ts",
    "./tsconfig.base.json": "./tsconfig.base.json",
    "./rollup": "./scripts/rollupPreset.js",
    "./eslint": "./scripts/eslintPreset.js"
  },
  "bin": {
    "sheets-framework": "scripts/sheets-framework.js"
  },
  "files": [
    "src",
    "tsconfig.base.json",
    "scripts",
    "docs",
    "CONTEXT.md",
    "!**/AGENTS.md",
    "!**/CLAUDE.md"
  ],
  "scripts": {
    "tsc": "tsc -p . && tsc -p scripts",
    "lint": "eslint . && npm run -s lint:docs",
    "lint:docs": "lint-docs --published .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "chore": "node scripts/sheets-framework.js chore",
    "gen:configs": "node scripts/sheets-framework.js gen-configs",
    "probe": "node scripts/sheets-framework.js probe",
    "build": "rollup --config && clasp push",
    "push": "clasp push",
    "run": "clasp run"
  },
  "dependencies": {
    "tslib": "^2.8.1",
    "tsx": "^4.23.13"
  },
  "peerDependencies": {
    "@byronbroughten/config": "^0.1.0",
    "@rollup/plugin-typescript": "^12.1.4",
    "eslint": "^9.35.0",
    "rollup": "^4.54.0",
    "vitest": "^4.1.11"
  },
  "peerDependenciesMeta": {
    "@byronbroughten/config": {
      "optional": true
    },
    "@rollup/plugin-typescript": {
      "optional": true
    },
    "eslint": {
      "optional": true
    },
    "rollup": {
      "optional": true
    },
    "vitest": {
      "optional": true
    }
  },
  "devDependencies": {
    "@byronbroughten/config": "^0.1.0",
    "@google/clasp": "^3.4.1",
    "@rollup/plugin-typescript": "^12.1.4",
    "@types/estree": "^1.0.8",
    "@types/google-apps-script": "^2.0.11",
    "@types/node": "^22.20.4",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^9.35.0",
    "rollup": "^4.54.0",
    "typescript": "^5.9.2",
    "vitest": "^4.1.11"
  }
}
