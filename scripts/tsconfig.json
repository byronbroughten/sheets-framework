{
  // The Node program: scripts/ run under Node's type stripping. Self-contained, since scripts/ ships in the package.
  "compilerOptions": {
    "target": "ES2023",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "customConditions": ["source"], // Reaches @byronbroughten/utils' src/, as the bin's resolve hook does at run time.
    "lib": ["esnext"],
    "types": ["node", "google-apps-script"],
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "allowJs": true,
    "maxNodeModuleJsDepth": 1, // @byronbroughten/code-style ships JS without .d.ts, so an npm install needs this to type it.
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "skipLibCheck": true,

    "noImplicitAny": true,
    "strictNullChecks": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitReturns": true
  },
  "include": ["**/*.ts", "../src/TypeDeclarations/**/*.ts"]
}
